{
  "name": "dulting-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "db:up": "docker compose up --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up --wait postgres && pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "smoke:local-import": "node scripts/local-import-smoke.mjs",
    "validate:data": "vitest run src/lib/studio-data/repository.test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.11.0",
    "@navikt/ds-css": "^8.11.0",
    "@navikt/ds-react": "^8.11.0",
    "@navikt/oasis": "^4.1.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}

# Lokal PostgreSQL for Drizzle-kommandoer.
# Ikke legg inn ekte secrets eller delte miljøverdier i denne filen.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dulting_studio

# Opt-in lokal auth-mock for API-kall fra localhost.
# Skal aldri brukes i produksjon; koden ignorerer flagget når NODE_ENV=production.
LOCAL_AUTH_MOCK_ENABLED=false
LOCAL_AUTH_MOCK_NAV_IDENT=Z999999
LOCAL_AUTH_MOCK_NAME="Lokal utvikler"
LOCAL_AUTH_MOCK_EMAIL=local.dev@nav.no
LOCAL_AUTH_MOCK_GROUPS=
